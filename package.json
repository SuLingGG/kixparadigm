{
  "name": "kixparadigm",
  "version": "1.4.0",
  "description": "kixparadigm DSH-only distribution: kix presets, child-role presets, and the 0.2.2-rc.5 compatibility patch for DeepSeek Harness",
  "license": "MIT",
  "author": "kix (olicesx), DSH-only fork by SuLingGG",
  "keywords": [
    "kixparadigm",
    "kixpower",
    "kix",
    "agent",
    "ai-agent",
    "deepseek-harness",
    "dsh",
    "agent-preset"
  ],
  "bin": {
    "kixparadigm": "bin/kixparadigm.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "dsh/",
    "docs/",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/install-lib.js --quiet",
    "install": "node bin/kixparadigm.js install",
    "doctor": "node bin/kixparadigm.js doctor",
    "uninstall": "node bin/kixparadigm.js uninstall",
    "runtime-patch": "node scripts/patch-dsh-runtime.js",
    "test:installer": "node --test scripts/install-lib.test.js",
    "test:runtime-patch": "node --test scripts/patch-dsh-runtime.test.js",
    "test:plugins": "cd dsh/preset/plugins && node --test",
    "test": "npm run test:installer && npm run test:runtime-patch && npm run test:consistency && npm run test:plugins",
    "test:consistency": "node scripts/check-dsh-consistency.cjs"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "kixparadigm": {
    "variants": [
      {
        "id": "kixparadigm",
        "dir": "dsh/preset"
      },
      {
        "id": "kixparadigm-classic",
        "dir": "dsh/preset-classic"
      }
    ],
    "bridgeDir": "dsh/vision-bridge"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SuLingGG/kixparadigm.git"
  },
  "bugs": {
    "url": "https://github.com/SuLingGG/kixparadigm/issues"
  },
  "homepage": "https://github.com/SuLingGG/kixparadigm#readme"
}
